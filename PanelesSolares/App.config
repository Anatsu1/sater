<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
    <appSettings>
        <!-- Proveedor de base de datos.
             auto   = Jet/Access en Windows, SQLite fuera de Windows (recomendado)
             oledb  = fuerza Microsoft.Jet.OLEDB.4.0 (requiere Windows 32 bits)
             sqlite = fuerza SQLite -->
        <add key="proveedor" value="auto" />
        <!-- Archivo de base. Si se omite se usa paneleSolares.mdb con oledb
             y paneleSolares.db con sqlite. Siempre se resuelve junto al .exe. -->
        <!-- <add key="archivoBase" value="paneleSolares.mdb" /> -->
    </appSettings>
</configuration>
